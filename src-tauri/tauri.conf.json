{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "JMO Script",
  "version": "0.1.0",
  "identifier": "com.jgraves.jmo-script",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1425",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "JMO Script",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "startMenuFolder": "JMO Creative",
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "template": "../../jmo-core/installer/installer.nsi"
      },
      "wix": {
        "fragmentPaths": [
          "../../jmo-core/installer/startmenu.wxs"
        ],
        "componentGroupRefs": [
          "JmoStartMenuShortcut"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
